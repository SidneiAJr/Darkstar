# -----------------------------------------------
# TANIS — Environment Configuration
# -----------------------------------------------
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env
# -----------------------------------------------

# App
APP_NAME=Tanis
APP_ENV=local                        # local | development | staging | production
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=3000
APP_KEY=                             # gerado pelo: tanis artisan key:generate

# Locale
APP_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

# -----------------------------------------------
# Database
# -----------------------------------------------
DB_CONNECTION=sqlite                 # sqlite | mysql | postgres
DB_HOST=127.0.0.1
DB_PORT=3306                         # mysql: 3306 | postgres: 5432
DB_DATABASE=database.sqlite
DB_USERNAME=                         # Seu usuario do banco Local
DB_PASSWORD=                         # Sua senha do banco local

# -----------------------------------------------
# Cache
# -----------------------------------------------
CACHE_DRIVER=memory                  # memory | redis

# -----------------------------------------------
# Session
# -----------------------------------------------
SESSION_DRIVER=memory                # memory | redis | database
SESSION_LIFETIME=120                 # em minutos
SESSION_SECRET=                      # gerado pelo: tanis artisan key:generate

# -----------------------------------------------
# Queue
# -----------------------------------------------
QUEUE_CONNECTION=sync                # sync | redis | database

# -----------------------------------------------
# Redis
# -----------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# -----------------------------------------------
# Auth / JWT
# -----------------------------------------------
JWT_SECRET=                          # gerado pelo: tanis artisan key:generate
JWT_EXPIRES_IN=                      # ex: 60s | 10m | 2h | 7d
JWT_REFRESH_EXPIRES_IN=              # ex: 60s | 10m | 2h | 7d 

# -----------------------------------------------
# Mail
# -----------------------------------------------
MAIL_DRIVER=log                      # log | smtp | ses | sendgrid
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=null                 # null | tls | ssl

# -----------------------------------------------
# Storage / AWS S3
# -----------------------------------------------
FILESYSTEM_DISK=local                # local | s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=                        # para MinIO ou S3-compatíveis

# -----------------------------------------------
# Logging
# -----------------------------------------------
LOG_CHANNEL=console                  # console | file | combined
LOG_LEVEL=debug                      # debug | info | warn | error
LOG_FILE=storage/logs/tanis.log
