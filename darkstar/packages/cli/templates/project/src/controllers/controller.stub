import { TanisRequest, TanisResponse } from '@darkstar-cli/core'
import { {{name}}Service } from '../services/{{name}}Service'

export class {{name}}Controller {
  constructor(private {{nameLower}}Service: {{name}}Service) {}

  async index(req: TanisRequest, res: TanisResponse) {
    const data = await this.{{nameLower}}Service.findAll()
    return res.ok(data)
  }

  async show(req: TanisRequest, res: TanisResponse) {
    const data = await this.{{nameLower}}Service.findById(req.param('id')!)
    if (!data) return res.notFound('{{name}} não encontrado')
    return res.ok(data)
  }

  async store(req: TanisRequest, res: TanisResponse) {
    const data = await this.{{nameLower}}Service.create(req.all())
    return res.created(data)
  }

  async update(req: TanisRequest, res: TanisResponse) {
    const data = await this.{{nameLower}}Service.update(req.param('id')!, req.all())
    return res.ok(data)
  }

  async destroy(req: TanisRequest, res: TanisResponse) {
    await this.{{nameLower}}Service.delete(req.param('id')!)
    return res.noContent()
  }
}
