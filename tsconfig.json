{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "types": ["node"],
    "paths": {
      "darkstar-orm":  ["../orm/src/index.ts"],
      "darkstar-core": ["../core/src/index.ts"]
    }
  },
  "references": [
    { "path": "../orm" },
    { "path": "../core" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}