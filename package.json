{
  "name": "darkstar",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/core",
    "packages/orm"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "dev": "npm run build && node packages/cli/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3"
  }
}